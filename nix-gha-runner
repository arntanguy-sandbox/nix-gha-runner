#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./nix-gha-runner [--ssh-public-key <path>] <organization> [instance-number-or-range] [loop=true]
       ./nix-gha-runner --stop <organization> [instance-number-or-range]
       ./nix-gha-runner --kill <organization> [instance-number-or-range]
       ./nix-gha-runner --list

Start detached ephemeral GitHub Actions runners in NixOS MicroVMs.

Arguments:
  organization               GitHub organization: arntanguy-sandbox or isri-aist
  instance-number-or-range   Positive VM number or inclusive range such as 1-5;
                              defaults to 1
  loop=true                  Restart a fresh VM after every VM exit

Options:
  --ssh-public-key <path>    Authorize the public key in <path> for root SSH access.
                              This enables a loopback-only SSH port for each VM.
  --stop                      Let active jobs finish, then stop managed VM supervisors.
  --kill                      Immediately terminate managed VMs and supervisors.
  --list                      Show all running managed VM supervisors.
  --help                      Show this help text.

Each instance starts in the background. Its console log and supervisor PID are stored
in volumes/gh-runner-org-<org>-<host>-<instance>/ as microvm.log and microvm.pid;
the active VM PID is microvm.vm.pid. Use --stop for graceful drain or --kill for
immediate termination. Use --list to display all active managed instances and their
logs.

The runner name and persistent volume directory include the organization, the
invoking host's short hostname, and the instance number. Ranges launch all selected
instances concurrently. With loop=true, each instance independently starts a fresh
VM after every exit.
EOF
}

internal_mode=false
if [[ ${1:-} == --internal-run-instance ]]; then
  internal_mode=true
  shift
fi

if [[ $internal_mode == true ]]; then
  if (($# != 6)); then
    printf 'Invalid internal runner invocation.\n' >&2
    exit 2
  fi

  organization=$1
  instance_number=$2
  loop=$3
  host_name=$4
  ssh_host_port=$5
  state_directory=$6
  pid_file="${state_directory}/microvm.pid"
  vm_pid_file="${state_directory}/microvm.vm.pid"
  stop_file="${state_directory}/microvm.stop"
  ssh_public_key=${RUN_GH_ACTION_MICROVM_SSH_PUBLIC_KEY:-}
  repository_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  cd "$repository_root"
else
  action=launch
  ssh_public_key_path=
  declare -a positional_arguments=()

  while (($# > 0)); do
    case $1 in
      --help)
        usage
        exit 0
        ;;
      --ssh-public-key)
        if (($# < 2)); then
          printf 'Missing path after --ssh-public-key.\n' >&2
          exit 2
        fi
        if [[ -n $ssh_public_key_path ]]; then
          printf '%s\n' '--ssh-public-key may only be specified once.' >&2
          exit 2
        fi
        ssh_public_key_path=$2
        shift 2
        ;;
      --stop | --kill | --list)
        if [[ $action != launch ]]; then
          printf 'Only one management action may be specified.\n' >&2
          exit 2
        fi
        action=${1#--}
        shift
        ;;
      --)
        shift
        positional_arguments+=("$@")
        break
        ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        exit 2
        ;;
      *)
        positional_arguments+=("$1")
        shift
        ;;
    esac
  done

  minimum_arguments=1
  maximum_arguments=3
  if [[ $action == list ]]; then
    minimum_arguments=0
    maximum_arguments=0
  elif [[ $action != launch ]]; then
    maximum_arguments=2
  fi
  if ((${#positional_arguments[@]} < minimum_arguments || ${#positional_arguments[@]} > maximum_arguments)); then
    usage >&2
    exit 2
  fi

  if [[ $action != launch && -n $ssh_public_key_path ]]; then
    printf '%s\n' "--ssh-public-key cannot be used with --${action}." >&2
    exit 2
  fi

  if [[ $action != list ]]; then
    organization=${positional_arguments[0]}
    instance_specification=${positional_arguments[1]:-1}
    loop=${positional_arguments[2]:-false}

    case "$organization" in
      arntanguy-sandbox | isri-aist | jrl-umi3218) ;;
      *)
        printf 'Unsupported GitHub organization: %s\n' "$organization" >&2
        usage >&2
        exit 2
        ;;
    esac

    if [[ $loop != true && $loop != false ]]; then
      printf 'Loop must be true or false: %s\n' "$loop" >&2
      exit 2
    fi

    declare -a instance_numbers
    if [[ $instance_specification =~ ^[1-9][0-9]*$ ]]; then
      instance_numbers=("$instance_specification")
    elif [[ $instance_specification =~ ^([1-9][0-9]*)-([1-9][0-9]*)$ ]]; then
      range_start=${BASH_REMATCH[1]}
      range_end=${BASH_REMATCH[2]}
      if ((range_start > range_end)); then
        printf 'Instance range start must not exceed its end: %s\n' "$instance_specification" >&2
        exit 2
      fi

      for ((instance_number = range_start; instance_number <= range_end; instance_number++)); do
        instance_numbers+=("$instance_number")
      done
    else
      printf 'Instance number must be a positive integer or inclusive range: %s\n' "$instance_specification" >&2
      exit 2
    fi
  fi

  ssh_public_key=
  if [[ $action == launch && -n $ssh_public_key_path ]]; then
    if [[ ! -f $ssh_public_key_path || ! -r $ssh_public_key_path ]]; then
      printf 'SSH public-key file is not readable: %s\n' "$ssh_public_key_path" >&2
      exit 2
    fi

    ssh_public_key=$(<"$ssh_public_key_path")
    if [[ -z ${ssh_public_key//[[:space:]]/} || $ssh_public_key == *$'\n'* ]]; then
      printf 'SSH public-key file must contain exactly one non-empty key: %s\n' "$ssh_public_key_path" >&2
      exit 2
    fi
  fi

  repository_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  cd "$repository_root"
  if [[ $action != list ]]; then
    host_name=$(hostname --short)
    if [[ ! $host_name =~ ^[[:alnum:]][[:alnum:].-]*$ ]]; then
      printf 'Host name contains unsupported characters: %s\n' "$host_name" >&2
      exit 2
    fi
  fi
fi

run_instance() {
  local instance_number=$1
  local ssh_port=$2
  local runner

  runner=$(RUN_GH_ACTION_MICROVM_SSH_PUBLIC_KEY="$ssh_public_key" RUN_HOST_HOSTNAME="$host_name" \
    nix --extra-experimental-features 'nix-command flakes' build --impure --no-link --print-out-paths \
      --expr "let
        flake = builtins.getFlake \"git+file://${repository_root}\";
      in
        flake.lib.mkRunner {
          organization = \"${organization}\";
          instanceNumber = ${instance_number};
          hostName = builtins.getEnv \"RUN_HOST_HOSTNAME\";
          sshPublicKey =
            let key = builtins.getEnv \"RUN_GH_ACTION_MICROVM_SSH_PUBLIC_KEY\";
            in if key == \"\" then null else key;
          sshHostPort = ${ssh_port:-null};
        }")

  run_vm() {
    "$runner/bin/microvm-run" &
    active_vm_pid=$!
    printf '%s\n' "$active_vm_pid" >"$vm_pid_file"
    if wait "$active_vm_pid"; then
      status=0
    else
      status=$?
    fi
    active_vm_pid=
    rm -f -- "$vm_pid_file"
    return "$status"
  }

  if [[ -e $stop_file ]]; then
    return 0
  fi

  if [[ $loop == false ]]; then
    run_vm
    return
  fi

  while true; do
    if run_vm; then
      status=0
    else
      status=$?
    fi
    printf 'VM instance %s exited with status %d; restarting.\n' "$instance_number" "$status" >&2
    if [[ -e $stop_file ]]; then
      return "$status"
    fi
  done
}

if [[ $internal_mode == true ]]; then
  active_vm_pid=
  stop_active_vm() {
    if [[ -n $active_vm_pid ]]; then
      kill -TERM "$active_vm_pid" 2>/dev/null || true
      wait "$active_vm_pid" 2>/dev/null || true
    fi
  }
  remove_pid_file() {
    rm -f -- "$pid_file" "$vm_pid_file" "$stop_file"
  }
  trap 'stop_active_vm; exit 143' INT TERM
  trap remove_pid_file EXIT
  printf '%s\n' "$$" >"$pid_file"
  run_instance "$instance_number" "$ssh_host_port"
  exit $?
fi

ssh_port_for_instance() {
  local instance_number=$1
  local port_base

  if [[ -z $ssh_public_key ]]; then
    return
  fi
  if ((instance_number > 9999)); then
    printf 'SSH-enabled instance numbers must not exceed 9999: %s\n' "$instance_number" >&2
    return 1
  fi

  case "$organization" in
    arntanguy-sandbox) port_base=22000 ;;
    isri-aist) port_base=32000 ;;
    jrl-umi3218) port_base=42000 ;;
  esac
  printf '%d\n' "$((port_base + instance_number))"
}

wait_for_supervisor() {
  local supervisor_pid=$1

  while kill -0 "$supervisor_pid" 2>/dev/null; do
    sleep 0.1
  done
}

manage_instance() {
  local instance_number=$1
  local state_directory="volumes/gh-runner-org-${organization}-${host_name}-${instance_number}"
  local pid_file="${state_directory}/microvm.pid"
  local vm_pid_file="${state_directory}/microvm.vm.pid"
  local stop_file="${state_directory}/microvm.stop"
  local supervisor_pid
  local vm_pid

  if [[ ! -f $pid_file ]]; then
    printf 'No managed VM is running for instance %s.\n' "$instance_number"
    rm -f -- "$vm_pid_file" "$stop_file"
    return
  fi

  supervisor_pid=$(<"$pid_file")
  if [[ ! $supervisor_pid =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$supervisor_pid" 2>/dev/null; then
    printf 'Removing stale state for instance %s.\n' "$instance_number"
    rm -f -- "$pid_file" "$vm_pid_file" "$stop_file"
    return
  fi

  if [[ $action == stop ]]; then
    : >"$stop_file"
    printf 'Waiting for VM instance %s to finish its current job.\n' "$instance_number"
    wait_for_supervisor "$supervisor_pid"
    printf 'VM instance %s stopped gracefully.\n' "$instance_number"
    return
  fi

  if [[ -f $vm_pid_file ]]; then
    vm_pid=$(<"$vm_pid_file")
    if [[ $vm_pid =~ ^[1-9][0-9]*$ ]] && kill -0 "$vm_pid" 2>/dev/null; then
      kill -KILL "$vm_pid" 2>/dev/null || true
    fi
  fi
  kill -KILL "$supervisor_pid" 2>/dev/null || true
  wait_for_supervisor "$supervisor_pid"
  rm -f -- "$pid_file" "$vm_pid_file" "$stop_file"
  printf 'VM instance %s killed.\n' "$instance_number"
}

list_managed_instances() {
  local state_directory
  local state_name
  local organization
  local candidate
  local prefix
  local instance_metadata
  local host_name
  local instance_number
  local pid_file
  local vm_pid_file
  local stop_file
  local supervisor_pid
  local vm_pid
  local status
  local found=false

  if [[ ! -d volumes ]]; then
    printf 'No managed VMs are running.\n'
    return
  fi

  printf '%-20s %-24s %-8s %-10s %-10s %-9s %s\n' \
    'ORGANIZATION' 'HOST' 'INSTANCE' 'SUPERVISOR' 'VM' 'STATUS' 'LOG'

  while IFS= read -r -d '' state_directory; do
    state_name=${state_directory##*/}
    organization=
    for candidate in arntanguy-sandbox isri-aist jrl-umi3218; do
      prefix="gh-runner-org-${candidate}-"
      if [[ $state_name == "$prefix"* ]]; then
        organization=$candidate
        instance_metadata=${state_name#"$prefix"}
        break
      fi
    done

    if [[ -z $organization || ! $instance_metadata =~ ^(.+)-([1-9][0-9]*)$ ]]; then
      continue
    fi
    host_name=${BASH_REMATCH[1]}
    instance_number=${BASH_REMATCH[2]}
    pid_file="${state_directory}/microvm.pid"
    vm_pid_file="${state_directory}/microvm.vm.pid"
    stop_file="${state_directory}/microvm.stop"

    if [[ ! -f $pid_file ]]; then
      continue
    fi
    supervisor_pid=$(<"$pid_file")
    if [[ ! $supervisor_pid =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$supervisor_pid" 2>/dev/null; then
      rm -f -- "$pid_file" "$vm_pid_file" "$stop_file"
      continue
    fi

    vm_pid=-
    status=STARTING
    if [[ -f $vm_pid_file ]]; then
      vm_pid=$(<"$vm_pid_file")
      if [[ ! $vm_pid =~ ^[1-9][0-9]*$ ]] || ! kill -0 "$vm_pid" 2>/dev/null; then
        rm -f -- "$vm_pid_file"
        vm_pid=-
      else
        status=RUNNING
      fi
    fi
    if [[ -f $stop_file ]]; then
      status=STOPPING
    fi

    printf '%-20s %-24s %-8s %-10s %-10s %-9s %s\n' \
      "$organization" "$host_name" "$instance_number" "$supervisor_pid" "$vm_pid" "$status" \
      "${state_directory}/microvm.log"
    found=true
  done < <(find volumes -mindepth 1 -maxdepth 1 -type d -name 'gh-runner-org-*' -print0 | sort -z)

  if [[ $found == false ]]; then
    printf 'No managed VMs are running.\n'
  fi
}

if [[ $action == list ]]; then
  list_managed_instances
  exit 0
fi

if [[ $action != launch ]]; then
  for instance_number in "${instance_numbers[@]}"; do
    manage_instance "$instance_number"
  done
  exit 0
fi

declare -a launched_pids=()
cleanup_launches() {
  local launched_pid

  trap - INT TERM
  for launched_pid in "${launched_pids[@]}"; do
    kill -TERM "$launched_pid" 2>/dev/null || true
  done
  exit 130
}

trap cleanup_launches INT TERM

for instance_number in "${instance_numbers[@]}"; do
  volume_directory="volumes/gh-runner-org-${organization}-${host_name}-${instance_number}"
  log_file="${volume_directory}/microvm.log"
  pid_file="${volume_directory}/microvm.pid"
  mkdir -p "$volume_directory"

  if [[ -f $pid_file ]]; then
    existing_pid=$(<"$pid_file")
    if [[ $existing_pid =~ ^[1-9][0-9]*$ ]] && kill -0 "$existing_pid" 2>/dev/null; then
      printf 'VM instance %s is already running (PID %s).\n' "$instance_number" "$existing_pid" >&2
      cleanup_launches
    fi
    rm -f -- "$pid_file" "${volume_directory}/microvm.vm.pid" "${volume_directory}/microvm.stop"
  fi
  rm -f -- "${volume_directory}/microvm.vm.pid" "${volume_directory}/microvm.stop"

  ssh_port=$(ssh_port_for_instance "$instance_number") || cleanup_launches

  RUN_GH_ACTION_MICROVM_SSH_PUBLIC_KEY="$ssh_public_key" \
    nohup "$repository_root/nix-gha-runner" \
      --internal-run-instance "$organization" "$instance_number" "$loop" "$host_name" "$ssh_port" "$volume_directory" \
      >"$log_file" 2>&1 < /dev/null &
  launched_pid=$!
  launched_pids+=("$launched_pid")

  state_ready=false
  for ((attempt = 0; attempt < 20; attempt++)); do
    if [[ -s $pid_file ]]; then
      state_ready=true
      break
    fi
    if ! kill -0 "$launched_pid" 2>/dev/null; then
      break
    fi
    sleep 0.05
  done
  if [[ $state_ready == false ]]; then
    printf 'VM instance %s failed to initialize; inspect %s.\n' "$instance_number" "$log_file" >&2
    cleanup_launches
  fi

  printf 'Started VM instance %s (PID %s).\n' "$instance_number" "$(cat "$pid_file")"
  printf '  Log:  %s\n' "$log_file"
  printf '  Stop: kill "$(cat %s)"\n' "$pid_file"
  if [[ -n $ssh_port ]]; then
    printf '  SSH:  ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p %s root@127.0.0.1\n' "$ssh_port"
  fi
done

trap - INT TERM
