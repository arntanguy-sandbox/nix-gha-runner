#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./run-gh-action-microvm <organization> [instance-number] [loop=true]

Start an ephemeral GitHub Actions runner in a NixOS MicroVM.

Arguments:
  organization       GitHub organization: arntanguy-sandbox or isri-aist
  instance-number   Positive per-host VM number; defaults to 1
  loop=true          Restart a fresh VM after every VM exit

The runner name and persistent volume directory include the organization, the
invoking host's short hostname, and the instance number. Reuse an instance number
to reuse its Nix store and ccache overlays; use a different number for concurrent
VMs of the same organization on one host.

The guest registers an ephemeral runner, processes one GitHub Actions job, then
powers itself off. Without loop=true, this command exits with the VM's exit status.
With loop=true, it continually starts fresh VMs after every exit, including failures.
EOF
}

if (($# == 1)) && [[ $1 == --help ]]; then
  usage
  exit 0
fi

if (($# < 1 || $# > 3)); then
  usage >&2
  exit 2
fi

organization=$1
instance_number=${2:-1}
loop=${3:-false}

case "$organization" in
  arntanguy-sandbox | isri-aist) ;;
  *)
    printf 'Unsupported GitHub organization: %s\n' "$organization" >&2
    usage >&2
    exit 2
    ;;
esac

if [[ ! $instance_number =~ ^[1-9][0-9]*$ ]]; then
  printf 'Instance number must be a positive integer: %s\n' "$instance_number" >&2
  exit 2
fi

if [[ $loop != true && $loop != false ]]; then
  printf 'Loop must be true or false: %s\n' "$loop" >&2
  exit 2
fi

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$repository_root"
host_name=$(hostname --short)
if [[ ! $host_name =~ ^[[:alnum:]][[:alnum:].-]*$ ]]; then
  printf 'Host name contains unsupported characters: %s\n' "$host_name" >&2
  exit 2
fi

volume_directory="volumes/gh-runner-org-${organization}-${host_name}-${instance_number}"
mkdir -p "$volume_directory"

runner=$(RUN_HOST_HOSTNAME="$host_name" nix --extra-experimental-features 'nix-command flakes' build --impure --no-link --print-out-paths \
  --expr "let
    flake = builtins.getFlake \"git+file://${repository_root}\";
  in
    flake.lib.mkRunner {
      organization = \"${organization}\";
      instanceNumber = ${instance_number};
      hostName = builtins.getEnv \"RUN_HOST_HOSTNAME\";
    }")

run_vm() {
  "$runner/bin/microvm-run"
}

if [[ $loop == false ]]; then
  exec "$runner/bin/microvm-run"
fi

while true; do
  set +e
  run_vm
  status=$?
  set -e
  printf 'VM exited with status %d; restarting.\n' "$status" >&2
done
